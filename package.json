{
  "name": "ios-video-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "eas:login": "eas login",
    "eas:configure": "eas build:configure",
    "build:ios:development": "eas build --platform ios --profile development",
    "build:ios:production": "eas build --platform ios --profile production",
    "build:android:development": "eas build --platform android --profile development",
    "build:android:production": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~55.0.23",
    "expo-av": "~16.0.8",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.32",
    "expo-image": "^55.0.10",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "eas-cli": "^18.11.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "^9.2.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.2"
  }
}
