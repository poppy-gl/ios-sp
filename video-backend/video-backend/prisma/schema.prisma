generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Video {
  id          String   @id
  title       String
  description String?
  cover       String?
  source      String
  sourceType  String
  category    String
  subCategory String?
  provider    String?
  seriesId    String?
  rawJson     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, updatedAt, id])
  @@index([subCategory, updatedAt, id])
  @@index([updatedAt, id])
  @@index([title])
}

model ResolvedEpisode {
  id            String   @id
  videoId       String
  line          Int
  episode       Int
  playPageUrl   String
  mediaUrl      String?
  format        String?
  sourceType    String?
  reachable     Boolean?
  failureReason String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([videoId, line, episode])
}
