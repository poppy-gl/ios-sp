PORT=3000
DATABASE_URL=file:C:/video-backend/data/app.db

# Generate fresh values on every server. Never commit real tokens.
API_TOKEN=replace-with-a-new-random-token
ADMIN_TOKEN=replace-with-a-new-random-admin-token

# The scheduled-task scripts provide production-safe defaults for these values.
ENABLE_IN_PROCESS_CRAWL_CRON=false
SEARCH_ON_DEMAND_CRAWL_ENABLED=true
RESOLVE_SUCCESS_CACHE_TTL_MS=86400000
RESOLVE_FAILURE_CACHE_TTL_MS=1800000
